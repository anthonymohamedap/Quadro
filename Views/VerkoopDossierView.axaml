<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:QuadroApp.ViewModels.Verkoop"
    xmlns:ovm="clr-namespace:QuadroApp.ViewModels"
    xmlns:offerte="clr-namespace:QuadroApp.Views.Offerte"
    xmlns:planning="clr-namespace:QuadroApp.Views.Planning"
    xmlns:werkbon="clr-namespace:QuadroApp.Views.Werkbon"
    xmlns:bestelbon="clr-namespace:QuadroApp.Views.Bestelbon"
    xmlns:conv="using:QuadroApp.Converters"
    x:Class="QuadroApp.Views.VerkoopDossierView"
    x:DataType="vm:VerkoopDossierViewModel"
    Background="{DynamicResource SurfaceMuted}">

    <!-- US-90: dossier-schil — kop, documentchips, stappenbalk (terugkijken), stapinhoud, voetbalk.
         De stappen gebruiken voorlopig de bestaande schermen (offerte, werkbon, planning, bestelbonnen). -->
    <UserControl.Styles>
        <Style Selector="Border.kaart">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <Style Selector="Border.chip.ontbreekt">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.chip.ontbreekt TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- Stappenbalk: klaar = groen ✓, huidig = geel, overgeslagen = gestreept, bekeken = kader -->
        <Style Selector="Button.stap">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Nog te doen: niet klikbaar, maar niet grijs gevuld zoals een uitgeschakelde knop -->
        <Style Selector="Button.stap:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.stap.huidig">
            <Setter Property="Background" Value="{DynamicResource BrandYellowHover}"/>
        </Style>
        <Style Selector="Button.stap.bekeken">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandYellow}"/>
        </Style>
        <Style Selector="Border.bol">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
        </Style>
        <Style Selector="Border.bol.klaar">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="Border.bol.huidig">
            <Setter Property="Background" Value="{DynamicResource BrandYellow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandYellow}"/>
        </Style>
        <Style Selector="TextBlock.bolTekst">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.bolTekst.klaar">
            <Setter Property="Foreground" Value="{DynamicResource TextOnDark}"/>
        </Style>
        <Style Selector="TextBlock.bolTekst.huidig">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.stapTitel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.stapTitel.actief">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.stapTitel.overgeslagen">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Kop ── -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="24,14,24,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2">
                        <Button Content="◀ Verkopen" Command="{Binding TerugNaarVerkopenCommand}"
                                Background="Transparent" Padding="0" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Titel}" Classes="h1" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding KlantRegel}" Classes="body" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource WarningBg}" CornerRadius="10" Padding="9,2">
                                <TextBlock Text="{Binding StatusTekst}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Totaal incl." Classes="label" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TotaalTekst}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Right"
                                Background="{DynamicResource StatOrangeBg}" IsVisible="{Binding !IsAllesBetaald}">
                            <TextBlock Text="{Binding NogTeBetalenTekst}" FontWeight="SemiBold" Foreground="{DynamicResource StatOrangeText}"/>
                        </Border>
                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Right"
                                Background="{DynamicResource SuccessBg}" IsVisible="{Binding IsAllesBetaald}">
                            <TextBlock Text="{Binding NogTeBetalenTekst}" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                        </Border>
                    </StackPanel>

                    <!-- Menu ⋯ -->
                    <Button Grid.Column="2" Content="⋯" VerticalAlignment="Top" Padding="12,4" CornerRadius="6"
                            ToolTip.Tip="Meer acties">
                        <Button.Flyout>
                            <MenuFlyout>
                                <!-- US-91: knoppen uit de voet van het offertescherm (stap 1) -->
                                <MenuItem Header="Opslaan" Command="{Binding BewaarNuCommand}"
                                          IsVisible="{Binding IsStap1Zichtbaar}"/>
                                <MenuItem Header="{Binding Stap1.BerekenKnopTekst, FallbackValue=''}" Command="{Binding Stap1.BerekenCommand, FallbackValue={x:Null}}"
                                          IsVisible="{Binding IsStap1Zichtbaar}"/>
                                <MenuItem Header="→ Verzonden" Command="{Binding Stap1.NaarVerzondenCommand, FallbackValue={x:Null}}"
                                          IsVisible="{Binding Stap1.KanNaarVerzonden, FallbackValue=False}"/>
                                <MenuItem Header="↩ Concept" Command="{Binding Stap1.TerugNaarConceptCommand, FallbackValue={x:Null}}"
                                          IsVisible="{Binding Stap1.KanTerugNaarConcept, FallbackValue=False}"/>
                                <MenuItem Header="↩ Verzonden" Command="{Binding Stap1.TerugNaarVerzondenCommand, FallbackValue={x:Null}}"
                                          IsVisible="{Binding Stap1.KanTerugNaarVerzonden, FallbackValue=False}"/>
                                <MenuItem Header="Ontgrendelen" Command="{Binding Stap1.OntgrendelenCommand, FallbackValue={x:Null}}"
                                          IsVisible="{Binding Stap1.IsOntgrendelenZichtbaar, FallbackValue=False}"/>
                                <MenuItem Header="Werkbon afdrukken met prijzen" Command="{Binding WerkbonAfdrukkenMetPrijzenCommand}"
                                          IsVisible="{Binding KanWerkbonAfdrukken}"/>
                                <MenuItem Header="Werkbon openen" Command="{Binding OpenWerkBonCommand}"
                                          IsVisible="{Binding ToontWerkbonKnoppen}"/>
                                <MenuItem Header="Offerte openen in het oude scherm" Command="{Binding OpenOfferteCommand}"/>
                                <MenuItem Header="Verkoop annuleren…" Command="{Binding AnnulerenCommand}"
                                          IsEnabled="{Binding KanAnnuleren}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Documentchips -->
                <WrapPanel>
                    <TextBlock Text="In deze verkoop:" Classes="label" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DossierChip">
                                <Border Classes="chip" Classes.ontbreekt="{Binding BestaatNiet}">
                                    <TextBlock Text="{Binding Tekst}" Classes="label"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ── Stappenbalk ── -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="24,8">
            <ItemsControl ItemsSource="{Binding Stappen}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DossierStap">
                        <Button Classes="stap" Classes.huidig="{Binding IsHuidig}" Classes.bekeken="{Binding IsBekeken}"
                                IsEnabled="{Binding KanBekijken}"
                                Command="{Binding $parent[UserControl].((vm:VerkoopDossierViewModel)DataContext).BekijkStapCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Klik om deze stap te bekijken">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border Classes="bol" Classes.klaar="{Binding IsKlaar}" Classes.huidig="{Binding IsHuidig}">
                                    <TextBlock Text="{Binding Bolletje}" Classes="bolTekst"
                                               Classes.klaar="{Binding IsKlaar}" Classes.huidig="{Binding IsHuidig}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Titel}" Classes="stapTitel"
                                               Classes.actief="{Binding !IsNogTeDoen}"
                                               Classes.overgeslagen="{Binding IsOvergeslagen}"/>
                                    <TextBlock Text="{Binding Onderschrift}" Classes="label" Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding Onderschrift, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ── Stapinhoud ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" Spacing="12">
                <Border Classes="kaart" IsVisible="{Binding IsTerugGekeken}" MaxWidth="1100" HorizontalAlignment="Left"
                        Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource InfoBorder}" Padding="12,8">
                    <TextBlock Text="{Binding TerugGekekenTekst}" TextWrapping="Wrap"
                               Foreground="{DynamicResource InfoText}" FontWeight="SemiBold"/>
                </Border>

                <!-- US-91: stap 1 = het offertescherm. Links "Inlijsting details", rechts klant,
                     inlijstingen, prijsaanpassingen/voorschot en totalen. Zelfde velden en knoppen. -->
                <Panel IsVisible="{Binding IsStap1Zichtbaar}">
                <Grid ColumnDefinitions="1.15*,1*" ColumnSpacing="20"
                      DataContext="{Binding Stap1}" x:DataType="ovm:OfferteViewModel">
                    <offerte:OfferteRegelEditor Titel="Inlijsting details" IsEnabled="{Binding KanBewerken}" VerticalAlignment="Top"/>

                    <StackPanel Grid.Column="1" Spacing="20">
                        <!-- US-101: afgerond en vergrendeld -->
                        <Border Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" IsVisible="{Binding IsAlleenLezen}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Success}" FontWeight="SemiBold"
                                       Text="Afgehaald en volledig betaald: deze verkoop is afgerond en kan niet meer gewijzigd worden."/>
                        </Border>
                        <!-- US-100: prijs vast sinds de bevestiging -->
                        <TextBlock IsVisible="{Binding IsPrijsVastMeldingZichtbaar}" Classes="caption" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="De klant heeft bevestigd: de prijzen staan vast en worden niet meer automatisch herberekend."/>

                        <offerte:OfferteKlantKaart/>
                        <offerte:OfferteRegelsKaart Titel="Inlijstingen"/>
                        <offerte:OffertePrijsKaart IsEnabled="{Binding KanBewerken}"/>

                        <Border Classes="quadro-card">
                            <StackPanel Spacing="8">
                                <offerte:OfferteTotalen HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding BestelbonStatusText}" Classes="label"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </Panel>

                <Border Classes="kaart" IsVisible="{Binding IsSamenvattingZichtbaar}" MaxWidth="1100" HorizontalAlignment="Left">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding BekekenTitel}" Classes="h2"/>
                            <TextBlock Text="{Binding BekekenUitleg}" Classes="body" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Gegevens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DossierGegeven">
                                    <Grid ColumnDefinitions="140,*" Margin="0,2">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Waarde}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Meldingen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="10,6" Margin="0,2">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bestaande schermen (zelfde functies als nu) -->
                        <WrapPanel>
                            <Button Content="Offerte openen" Command="{Binding OpenOfferteCommand}"
                                    IsVisible="{Binding ToontOfferteKnop}" Padding="10,5" CornerRadius="6" Margin="0,0,8,6"/>
                            <Button Content="Werkbon openen" Command="{Binding OpenWerkBonCommand}"
                                    IsVisible="{Binding ToontWerkbonKnoppen}" Padding="10,5" CornerRadius="6" Margin="0,0,8,6"/>
                            <Button Content="Planning openen" Command="{Binding OpenPlanningCommand}"
                                    IsVisible="{Binding ToontPlanningKnop}" Padding="10,5" CornerRadius="6" Margin="0,0,8,6"/>
                            <Button Content="Bestelbonnen openen" Command="{Binding OpenBestelbonnenCommand}"
                                    IsVisible="{Binding ToontBestelbonKnop}" Padding="10,5" CornerRadius="6" Margin="0,0,8,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- US-92: stap 2 = de planning van deze werkbon (zelfde kalender als de pagina Planning):
                     inlijstingen van de werkbon rechts, slepen of "Plan op geselecteerde dag". -->
                <Panel IsVisible="{Binding IsPlanningZichtbaar}">
                    <planning:WerkbonPlanner DataContext="{Binding Planner}"/>
                </Panel>

                <!-- ── US-93: stap 3 In productie = inhoud van het werkbonvenster ── -->
                <Grid IsVisible="{Binding IsStap3Zichtbaar}" ColumnDefinitions="1.6*,1*" ColumnSpacing="20">
                    <StackPanel Spacing="10" IsEnabled="{Binding !IsTerugGekeken}">
                        <TextBlock Text="Werktaken" Classes="h2"/>
                        <werkbon:WerkBonTaken DataContext="{Binding WerkbonDetail}"/>
                        <TextBlock Text="Nog geen werktaken: plan de inlijstingen in stap 2."
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding !WerkbonDetail.Taken.Count, FallbackValue=False}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="16">
                        <werkbon:WerkBonPlanningKaart DataContext="{Binding WerkbonDetail}"/>
                        <werkbon:WerkBonBestelbonKaart DataContext="{Binding WerkbonDetail}"
                                                       IsVisible="{Binding HeeftBestelbon, FallbackValue=False}"/>
                        <Border Classes="kaart">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Offerte" Classes="h2"/>
                                <TextBlock Text="{Binding OfferteSamenvatting}" Foreground="{DynamicResource TextSecondary}"/>
                                <Button Content="✎ Offerte aanpassen…" Command="{Binding OfferteAanpassenVanuitStapCommand}"
                                        Padding="10,5" CornerRadius="6" HorizontalAlignment="Left"
                                        ToolTip.Tip="Opent stap 1 om de offerte te wijzigen (zoals &quot;Open offerte&quot; in de werkbon)"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── US-93: stap 4 en 5 = bestelbon (scherm Bestelbonnen) + afrekenen (US-76) ── -->
                <StackPanel IsVisible="{Binding IsStap45Zichtbaar}" Spacing="16">
                    <!-- Afgerond (US-101) -->
                    <Border IsVisible="{Binding IsAfgerondMelding}" Background="{DynamicResource SuccessBg}"
                            BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <WrapPanel>
                            <TextBlock Text="Afgehaald en volledig betaald: deze verkoop is afgerond en kan niet meer gewijzigd worden."
                                       Foreground="{DynamicResource Success}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Ontgrendelen" Command="{Binding OntgrendelenVanuitAfgerondCommand}" Classes="GhostBtn"
                                    Padding="10,4" ToolTip.Tip="Enkel voor een beheerder: om een fout recht te zetten (US-101)"/>
                        </WrapPanel>
                    </Border>

                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="20">
                        <StackPanel Spacing="16">
                            <!-- Afrekenen bij afhaling (zoals in de werkbon) -->
                            <werkbon:WerkBonAfrekenen DataContext="{Binding WerkbonDetail}"
                                                      IsVisible="{Binding IsAfrekenenOpen, FallbackValue=False}"/>

                            <Border Classes="kaart" IsVisible="{Binding HeeftBestelbonDetail}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding BestelbonDetail.GeselecteerdeBestelbon.NummerLabel, StringFormat='Bestelbon {0}', FallbackValue=''}" Classes="h2"/>
                                        <Border Background="{DynamicResource SurfaceMutedAlt}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BestelbonDetail.GeselecteerdeBestelbon.Status, Converter={x:Static conv:StatusLabelConverter.Instance}, FallbackValue=''}"
                                                       Classes="caption" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <bestelbon:BestelbonVelden DataContext="{Binding BestelbonDetail}"/>
                                    <bestelbon:BestelbonLijnen DataContext="{Binding BestelbonDetail}" Height="220"/>
                                    <Button Content="Opslaan" Command="{Binding BestelbonDetail.SaveCommand, FallbackValue={x:Null}}"
                                            IsVisible="{Binding BestelbonDetail.IsDraft, FallbackValue=False}"
                                            Classes="AccentBtn" Padding="12,6" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="kaart" IsVisible="{Binding !HeeftBestelbonDetail}">
                                <TextBlock Text="Nog geen bestelbon voor deze verkoop." Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="16">
                            <Border Classes="kaart" IsVisible="{Binding HeeftBestelbonDetail}">
                                <StackPanel Spacing="10">
                                    <bestelbon:BestelbonBetalingen DataContext="{Binding BestelbonDetail}"/>
                                    <Button Content="Rest betaald" Command="{Binding BestelbonDetail.MarkeerBetaaldCommand, FallbackValue={x:Null}}"
                                            IsVisible="{Binding BestelbonDetail.HeeftRest, FallbackValue=False}"
                                            Padding="12,6" CornerRadius="6" HorizontalAlignment="Left"
                                            ToolTip.Tip="Registreert het restbedrag als betaling met de gekozen betaalwijze en zet de bestelbon op Betaald"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="kaart">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding WerkbonDetail.KopTitel, FallbackValue='Werkbon'}" Classes="h2"/>
                                    <TextBlock Text="{Binding WerkbonDetail.PlanningSamenvatting, FallbackValue=''}"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding WerkbonDetail.WerkBon.Status, Converter={x:Static conv:WerkBonStatusToLabelConverter.Instance}, FallbackValue=''}"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <!-- US-102: momentopname bij het afronden -->
                            <Border Classes="kaart" IsVisible="{Binding MomentopnameTekst, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Momentopname bij afronden" Classes="h2"/>
                                    <TextBlock Text="{Binding MomentopnameTekst}" Classes="caption" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <ItemsControl ItemsSource="{Binding MomentopnameRegels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Voetbalk ── -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0" Padding="24,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Button Content="◀ Vorige stap" Command="{Binding VorigeStapCommand}" IsEnabled="{Binding KanVorigeStap}"
                        Padding="10,6" CornerRadius="6"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StapTeller}" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding BewaardTekst}" Classes="caption" Foreground="{DynamicResource TextSecondary}"
                               IsVisible="{Binding BewaardTekst, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <!-- US-92: wat ontbreekt voor Start productie (stap 2, mock) -->
                <TextBlock Grid.Column="2" Text="{Binding VoetMelding}" Foreground="{DynamicResource Danger}"
                           TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0"
                           IsVisible="{Binding VoetMelding, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <!-- US-91: stap 1 — de bestelbon (voorlopig) als prijsvoorstel, zoals in het offertescherm -->
                    <Button Content="{Binding Stap1.BestelbonButtonText, FallbackValue=''}"
                            Command="{Binding Stap1.BestelbonCommand, FallbackValue={x:Null}}"
                            IsVisible="{Binding IsBestelbonKnopZichtbaar}"
                            Background="{DynamicResource InfoBorder}" Foreground="{DynamicResource InfoText}"
                            FontWeight="Bold" Padding="12,6" CornerRadius="6"/>
                    <Button Content="✎ Offerte aanpassen…" Command="{Binding OfferteAanpassenCommand}"
                            IsVisible="{Binding IsOfferteAanpassenZichtbaar}" Padding="12,6" CornerRadius="6"
                            ToolTip.Tip="De offerte na het akkoord nog wijzigen (zoals nu)"/>
                    <!-- US-93: stap 2 en 3 — rechtstreeks naar Klaar om af te halen, met reden -->
                    <Button Content="⤼ Stap overslaan" Command="{Binding StapOverslaanCommand}"
                            IsVisible="{Binding KanOverslaan}" Padding="12,6" CornerRadius="6"/>
                    <!-- US-94: werkbon voor het atelier (zonder prijzen), vanaf stap 2 -->
                    <Button Content="🖨 Werkbon afdrukken" Command="{Binding WerkbonAfdrukkenCommand}"
                            IsVisible="{Binding KanWerkbonAfdrukken}" Padding="12,6" CornerRadius="6"
                            ToolTip.Tip="PDF in Documenten › QuadroApp › Werkbonnen, opent in het printvenster van het systeem"/>
                    <!-- US-93: bestelbon afdrukken in elke status (zoals op het scherm Bestelbonnen) -->
                    <Button Content="🖨 Bestelbon afdrukken" Command="{Binding BestelbonDetail.AfdrukkenCommand, FallbackValue={x:Null}}"
                            IsVisible="{Binding IsStap45Zichtbaar}" IsEnabled="{Binding HeeftBestelbonDetail}"
                            Padding="12,6" CornerRadius="6"/>
                    <Button Content="Naar huidige stap ▶" Command="{Binding NaarHuidigeStapCommand}"
                            IsVisible="{Binding IsTerugGekeken}" Classes="AccentBtn" Padding="12,6"/>
                    <Button Content="{Binding HoofdKnopTekst}" Command="{Binding HoofdKnopCommand}"
                            IsVisible="{Binding IsHoofdKnopZichtbaar}" Classes="AccentBtn" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
