<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:QuadroApp.Converters"
    x:Class="QuadroApp.Views.WerkBonDetailWindow"
    x:CompileBindings="False"
    Width="660"
    Height="760"
    MinWidth="520"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    Title="{Binding KopTitel}"
    Background="{DynamicResource SurfaceMuted}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══ KOP ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel Spacing="10">

                <!-- Titel + status-badge -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KopTitel}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
                    <Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                            Background="{Binding WerkBon.Status, Converter={x:Static conv:WerkBonStatusToBrushConverter.Instance}}">
                        <TextBlock Text="{Binding WerkBon.Status, Converter={x:Static conv:WerkBonStatusToLabelConverter.Instance}}"
                                   Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Meta-rij -->
                <WrapPanel>
                    <TextBlock Text="{Binding KlantNaam}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding TotaalLabel}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding AangemaaktLabel}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding AfhaalLabel}" Foreground="{DynamicResource TextSecondary}"
                               IsVisible="{Binding HeeftAfhaalDatum}"/>
                </WrapPanel>

                <!-- Status wijzigen -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Status" VerticalAlignment="Center" Classes="caption"/>
                    <ComboBox MinWidth="170"
                              ItemsSource="{Binding StatusOpties}"
                              SelectedItem="{Binding GeselecteerdeStatus, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:WerkBonStatusToLabelConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Opslaan status"
                            Classes="MainBtn"
                            Command="{Binding SaveStatusCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ══ BODY ══ -->
        <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- Planning-samenvatting -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Planning" Classes="h2"/>
                        <TextBlock Text="{Binding PlanningSamenvatting}" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Gekoppelde bestelbon (read-only) -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12"
                        IsVisible="{Binding HeeftBestelbon}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Bestelbon" Classes="h2"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding Bestelbon.FactuurNummer, StringFormat='Nr. {0}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Bestelbon.Status, StringFormat='Status: {0}'}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Bestelbon.TotaalInclBtw, StringFormat='Totaal: € {0:N2}'}" Foreground="{DynamicResource TextSecondary}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Bestelbon.FactuurDatum, StringFormat='Datum: {0:dd/MM/yyyy}'}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Bestelbon.VervalDatum, StringFormat='Vervalt: {0:dd/MM/yyyy}'}" Foreground="{DynamicResource TextSecondary}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Taken -->
                <TextBlock Text="Werktaken" Classes="h2"/>

                <ItemsControl ItemsSource="{Binding Taken}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Omschrijving}" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Omschrijving}"/>
                                    <TextBlock Text="{Binding OfferteRegel.Titel, StringFormat='Titel: {0}'}"
                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding OfferteRegel.Titel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding OfferteRegel.LegacyCode, StringFormat='Code: {0}'}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding OfferteRegel.LegacyCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding OfferteRegel.AfmetingLabel, StringFormat='Afmeting: {0}'}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding OfferteRegel.InlegLabel}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding OfferteRegel.HeeftInleg}"/>
                                    <TextBlock Text="{Binding DuurMinuten, StringFormat='Duur: {0} min'}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding GeplandVan, StringFormat='Van: {0:dd/MM HH:mm}'}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding GeplandTot, StringFormat='Tot: {0:dd/MM HH:mm}'}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding OfferteRegel.AfhaalDatum, StringFormat='Afhalen: {0:dd/MM/yyyy}'}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding OfferteRegel.AfhaalDatum, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{Binding OfferteRegel.TypeLijst.Artikelnummer, StringFormat='Lijst: {0}'}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding OfferteRegel.TypeLijst.Artikelnummer}"/>
                                    <TextBlock Text="{Binding OfferteRegel.AfwerkingSamenvatting, StringFormat='Afwerking: {0}'}"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                               ToolTip.Tip="{Binding OfferteRegel.AfwerkingSamenvatting}"
                                               IsVisible="{Binding OfferteRegel.AfwerkingSamenvatting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding OfferteRegel.Opmerking, StringFormat='Opmerking: {0}'}"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                               IsVisible="{Binding OfferteRegel.Opmerking, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                    <!-- Status-chip (elkaar uitsluitend) -->
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
                                            Background="{DynamicResource SuccessBg}" IsVisible="{Binding IsBesteld}">
                                        <TextBlock Foreground="{DynamicResource Success}" FontWeight="SemiBold"
                                                   Text="{Binding BestelDatum, StringFormat='Besteld op {0:dd/MM/yyyy}'}"/>
                                    </Border>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
                                            Background="{DynamicResource SuccessBg}" IsVisible="{Binding IsOpVoorraad}">
                                        <TextBlock Text="Op voorraad — geen bestelling nodig"
                                                   Foreground="{DynamicResource Success}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Bestelblok enkel als er écht besteld moet worden -->
                                    <StackPanel Spacing="6" IsVisible="{Binding MoetBesteldWorden}">
                                        <Border Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="Te bestellen" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Bestelwijze" VerticalAlignment="Center" Classes="caption"/>
                                            <ComboBox MinWidth="150"
                                                      ItemsSource="{Binding BestelVormOpties}"
                                                      SelectedItem="{Binding GeselecteerdeBestelVorm, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static conv:BestelVormToLabelConverter.Instance}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Content="Bestelling plaatsen"
                                                Classes="AccentBtn"
                                                HorizontalAlignment="Left"
                                                Command="{Binding $parent[Window].DataContext.MarkeerLijstAlsBesteldCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ VOET ══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Content="Open offerte"
                        Classes="GhostBtn"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenOfferteCommand}"/>
                <Button Grid.Column="1"
                        Content="Sluiten"
                        Classes="MainBtn"
                        Command="{Binding SluitCommand}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
