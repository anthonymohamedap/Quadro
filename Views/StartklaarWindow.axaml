<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuadroApp.ViewModels.Gebruikers"
        xmlns:svc="clr-namespace:QuadroApp.Service"
        x:Class="QuadroApp.Views.StartklaarWindow"
        x:DataType="vm:StartklaarViewModel"
        Title="Startklaar maken"
        Width="820" Height="680"
        MinWidth="640" MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceMuted}">
	<Grid RowDefinitions="Auto,*,Auto" Margin="16">

		<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
			<TextBlock Classes="h2" Text="Startklaar maken"/>
			<Border Background="{DynamicResource DangerBg}" CornerRadius="8" Padding="12,10">
				<StackPanel Spacing="4">
					<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
							   Text="Dit verwijdert alle klanten, offertes, werkbonnen, bestelbonnen, betalingen en winkelverkopen. Dit kan niet ongedaan gemaakt worden."/>
					<TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
							   Text="Bedoeld voor de start op 1 januari: alles wat tijdens het testen ontstond, gaat weg. Wat nodig is om een offerte te maken, blijft. Maak eerst een back-up van de database (Scaleway: Backups → Create backup)."/>
				</StackPanel>
			</Border>
		</StackPanel>

		<Grid Grid.Row="1" ColumnDefinitions="*,12,*">
			<Border Grid.Column="0" Classes="Card">
				<StackPanel Spacing="6">
					<TextBlock Classes="h3" Text="Gaat weg"/>
					<ItemsControl ItemsSource="{Binding Weg}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="svc:StartklaarRegel">
								<Grid ColumnDefinitions="*,Auto" Margin="0,2">
									<TextBlock Text="{Binding Wat}" TextWrapping="Wrap"/>
									<TextBlock Grid.Column="1" Text="{Binding Aantal}" FontWeight="SemiBold" Margin="12,0,0,0"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,4"/>
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Totaal" FontWeight="Bold"/>
						<TextBlock Grid.Column="1" Text="{Binding TotaalWeg}" FontWeight="Bold"/>
					</Grid>
				</StackPanel>
			</Border>

			<Border Grid.Column="2" Classes="Card">
				<StackPanel Spacing="6">
					<TextBlock Classes="h3" Text="Blijft staan"/>
					<ItemsControl ItemsSource="{Binding Blijft}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="svc:StartklaarRegel">
								<Grid ColumnDefinitions="*,Auto" Margin="0,2">
									<TextBlock Text="{Binding Wat}" TextWrapping="Wrap"/>
									<TextBlock Grid.Column="1" Text="{Binding Aantal}" FontWeight="SemiBold" Margin="12,0,0,0"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"
							   Text="De voorraad van de lijsten blijft; gereserveerde voorraad gaat naar 0 (die hoorde bij de testwerkbonnen). Het eerste offertenummer wordt 1, de eerste bestelbon van 2027 wordt 2027-1."/>
				</StackPanel>
			</Border>
		</Grid>

		<StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
			<TextBlock Text="{Binding Foutmelding}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
					   IsVisible="{Binding Foutmelding, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<TextBlock Text="{Binding KlaarTekst}" Foreground="{DynamicResource Success}" FontWeight="SemiBold" TextWrapping="Wrap"
					   IsVisible="{Binding KlaarTekst, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
			<Grid ColumnDefinitions="Auto,200,*,Auto,Auto" ColumnSpacing="8">
				<TextBlock VerticalAlignment="Center" Text="Typ STARTKLAAR om te bevestigen:"/>
				<TextBox Grid.Column="1" Text="{Binding Bevestiging, Mode=TwoWay}" Watermark="STARTKLAAR"/>
				<Button Grid.Column="3" Classes="DangerBtn" Content="Alles wissen en startklaar maken"
						Command="{Binding UitvoerenCommand}"/>
				<Button Grid.Column="4" Classes="GhostBtn" Content="Sluiten" Click="Sluiten_Click"/>
			</Grid>
		</StackPanel>
	</Grid>
</Window>
