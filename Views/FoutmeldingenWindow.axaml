<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:QuadroApp.Views"
        x:Class="QuadroApp.Views.FoutmeldingenWindow"
        Title="Foutmeldingen"
        Width="1100" Height="700"
        MinWidth="820" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
	<DockPanel>
		<Button DockPanel.Dock="Bottom" Classes="GhostBtn" Content="Sluiten" Click="Sluiten_Click"
				HorizontalAlignment="Right" Margin="16,0,16,16"/>
		<v:FoutmeldingenView x:Name="Inhoud"/>
	</DockPanel>
</Window>
