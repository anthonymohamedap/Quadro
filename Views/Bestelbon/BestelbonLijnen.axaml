<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuadroApp.ViewModels"
    xmlns:conv="clr-namespace:QuadroApp.Converters"
    xmlns:m="clr-namespace:QuadroApp.Model.DB;assembly=QuadroApp.Data"
    x:Class="QuadroApp.Views.Bestelbon.BestelbonLijnen"
    x:DataType="vm:BestelbonnenViewModel">
    <!-- US-93: lijnen van de bestelbon. Uit BestelbonnenView gehaald (inhoud ongewijzigd), ook gebruikt in stap 4/5
         van het verkoopdossier. DataContext = BestelbonnenViewModel. -->
          <Border
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Background="{DynamicResource SurfaceMutedAlt}"
                  MinHeight="120"
                  Padding="6">
            <ListBox ItemsSource="{Binding Lijnen}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="2.6*,0.7*,0.9*,0.7*,0.9*" Margin="0,2">
                    <TextBlock Text="{Binding Omschrijving, Converter={x:Static conv:BestelbonOmschrijvingConverter.Instance}}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Aantal, StringFormat='{}{0:0.##}'}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding PrijsExcl}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding BtwPct}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{Binding TotaalIncl}" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
</UserControl>
