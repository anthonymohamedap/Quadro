<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuadroApp.ViewModels"
    xmlns:conv="clr-namespace:QuadroApp.Converters"
    xmlns:m="clr-namespace:QuadroApp.Model.DB;assembly=QuadroApp.Data"
    x:Class="QuadroApp.Views.Bestelbon.BestelbonBetalingen"
    x:DataType="vm:BestelbonnenViewModel">
    <!-- US-93: betalingen (vooraf, bij afhalen, achteraf) en registreren. Uit BestelbonnenView gehaald (inhoud ongewijzigd), ook gebruikt in stap 4/5
         van het verkoopdossier. DataContext = BestelbonnenViewModel. -->
          <Border
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  IsVisible="{Binding GeselecteerdeBestelbon, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Betalingen" Classes="h3"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                  <Run Text="Totaal"/>
                  <Run Text="{Binding StandTotaal, StringFormat='€ {0:0.00}'}" FontWeight="SemiBold"/>
                  <Run Text="  ·  voorschot"/>
                  <Run Text="{Binding StandVoorschot, StringFormat='€ {0:0.00}'}"/>
                  <Run Text="  ·  betaald"/>
                  <Run Text="{Binding StandBetaald, StringFormat='€ {0:0.00}'}"/>
                  <Run Text="  ·  nog te betalen"/>
                  <Run Text="{Binding StandRest, StringFormat='€ {0:0.00}'}" FontWeight="Bold"/>
                </TextBlock>
              </Grid>

              <ItemsControl ItemsSource="{Binding Betalingen}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:Ontvangst">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,2">
                      <TextBlock VerticalAlignment="Center" Text="{Binding Datum, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Betaalwijze, Converter={x:Static conv:BetaalwijzeToLabelConverter.Instance}}"/>
                      <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding BedragIncl, StringFormat='€ {0:0.00}'}"/>
                      <Button Grid.Column="3" Content="&#x2715;" Width="28" Height="24" Padding="0"
                              HorizontalContentAlignment="Center"
                              Background="{DynamicResource BorderSubtle}" Foreground="{DynamicResource TextPrimary}"
                              ToolTip.Tip="Betaling verwijderen"
                              Command="{Binding $parent[ItemsControl].((vm:BestelbonnenViewModel)DataContext).VerwijderBetalingCommand}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- US-74: twee rijen — de datumkiezer is te breed om naast bedrag en betaalwijze te passen. -->
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6" IsVisible="{Binding HeeftRest}">
                <NumericUpDown Grid.Row="0" Grid.Column="0" MinWidth="0" HorizontalAlignment="Stretch"
                               Minimum="0" Increment="5" FormatString="'€ '0.00" Watermark="Bedrag"
                               Value="{Binding NieuweBetalingBedrag, Mode=TwoWay}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding BetaalwijzeOpties}"
                          SelectedItem="{Binding NieuweBetalingBetaalwijze, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Betaalwijze">
                            <TextBlock Text="{Binding Converter={x:Static conv:BetaalwijzeToLabelConverter.Instance}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <DatePicker Grid.Row="1" Grid.Column="0" MinWidth="0" HorizontalAlignment="Stretch"
                            SelectedDate="{Binding NieuweBetalingDatum, Mode=TwoWay}"/>
                <Button Grid.Row="1" Grid.Column="1" Classes="AccentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="Betaling registreren" Command="{Binding RegistreerBetalingCommand}"/>
              </Grid>
            </StackPanel>
          </Border>
</UserControl>
