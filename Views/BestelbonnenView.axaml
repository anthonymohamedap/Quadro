<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuadroApp.Views.Controls"
             xmlns:vm="using:QuadroApp.ViewModels"
             xmlns:conv="clr-namespace:QuadroApp.Converters"
             xmlns:m="clr-namespace:QuadroApp.Model.DB;assembly=QuadroApp.Data"
             x:Class="QuadroApp.Views.BestelbonnenView"
             xmlns:bestelbon="clr-namespace:QuadroApp.Views.Bestelbon"
             x:DataType="vm:BestelbonnenViewModel"
             Background="{DynamicResource SurfaceMutedAlt}"
             Foreground="{DynamicResource TextPrimary}">

  <Grid RowDefinitions="Auto,*">

    <!-- ░░ HEADER ░░ -->
    <controls:QuadroHeader Grid.Row="0" Title="BESTELBONNEN" BackCommand="{Binding GaTerugCommand}"/>

    <!-- ░░ MAIN CONTENT ░░
         Beide kolommen zijn star-gesized met interne scrollregio's:
         de lijsten vullen de resthoogte en scrollen zelf, zodat niets clippt. -->
    <Grid Grid.Row="1" ColumnDefinitions="1.1*,1.4*" Margin="24" ColumnSpacing="16">

      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <TextBlock Text="Bestelbonnen" Classes="h1" TextTrimming="CharacterEllipsis"/>
        <TextBox Grid.Row="1" Watermark="Filter op nummer / klant / status" Text="{Binding FilterTekst, Mode=TwoWay}"/>
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Bestelbonnen}"
                 SelectedItem="{Binding GeselecteerdeBestelbon, Mode=TwoWay}"
                 MinHeight="120">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="1.2*,2*,1*" Margin="4">
                <TextBlock Text="{Binding NummerLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding KlantNaam}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KlantNaam}"/>
                <TextBlock Grid.Column="2" Text="{Binding Status, Converter={x:Static conv:StatusLabelConverter.Instance}}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="1"
              Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
          <TextBlock Text="Bestelbon details" Classes="h2" TextTrimming="CharacterEllipsis"/>

          <bestelbon:BestelbonVelden Grid.Row="1"/>

          <bestelbon:BestelbonLijnen Grid.Row="2"/>

          <!-- US-70: betalingen (vooraf / bij afhalen / achteraf; meerdere mogelijk, bv. cash + kaart) -->
          <bestelbon:BestelbonBetalingen Grid.Row="3" IsVisible="{Binding GeselecteerdeBestelbon, Converter={x:Static ObjectConverters.IsNotNull}}"/>

          <WrapPanel Grid.Row="4">
            <Button Classes="AccentBtn" Content="Opslaan" Command="{Binding SaveCommand}" Margin="0,0,8,6" Padding="12,8"/>
            <Button Classes="AccentBtn" Content="Afdrukken" Command="{Binding AfdrukkenCommand}" Margin="0,0,8,6" Padding="12,8"
                    ToolTip.Tip="Maakt de PDF in Documenten › QuadroApp › Bestelbonnen en opent hem — ook als de bon al betaald is"/>
            <Button Classes="AccentBtn" Content="Rest betaald" ToolTip.Tip="Registreert het restbedrag als betaling met de gekozen betaalwijze en zet de bestelbon op Betaald" Command="{Binding MarkeerBetaaldCommand}" Margin="0,0,0,6" Padding="12,8"/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
