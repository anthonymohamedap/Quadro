<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuadroApp.ViewModels"
             xmlns:sv="using:QuadroApp.Service.Verkoop"
             x:Class="QuadroApp.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="{DynamicResource SurfaceMutedAlt}">

    <!-- US-105 — beginscherm. Past zich aan de breedte aan via container queries (zie Styles onderaan). -->
    <Grid ColumnDefinitions="Auto,*" Container.Name="home" Container.Sizing="Width">

        <Border Classes="Zijbalk" Background="{DynamicResource BrandDark}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="12,16">
                <Border Classes="Logo" Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Left" Margin="6,4,0,18">
                    <Image Source="avares://QuadroApp/Assets/Quadro_logo2012_ZW1.jpg" Stretch="Uniform"/>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">
					<Button Classes="NavButton Actief" ToolTip.Tip="Beginscherm">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Beginscherm" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<TextBlock Classes="NavGroep" Text="VERKOOP"/>
					<Button Command="{Binding OpenOffertesLijstCommand}" Classes="NavButton" ToolTip.Tip="Offertes">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Offertes" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenWerkBonCommand}" Classes="NavButton" ToolTip.Tip="De werkbonnen van bevestigde offertes: inplannen, lijsten bestellen, afrekenen bij afhalen">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Werkbonnen" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenFacturenCommand}" Classes="NavButton" ToolTip.Tip="Bestelbonnen = de bon die de klant krijgt bij het afhalen">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Bestelbonnen" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenWinkelVerkopenCommand}" Classes="NavButton" ToolTip.Tip="Winkelverkopen">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.24-5.88c.09-.16.14-.35.14-.54 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Winkelverkopen" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenOverzichtBetalingenCommand}" Classes="NavButton" ToolTip.Tip="Overzicht betalingen">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M15 18.5c-2.51 0-4.68-1.42-5.76-3.5H15l1-2H8.58c-.05-.33-.08-.66-.08-1s.03-.67.08-1H16l1-2H9.24C10.32 6.92 12.5 5.5 15 5.5c1.61 0 3.09.59 4.23 1.57L21 5.3C19.41 3.87 17.3 3 15 3c-3.92 0-7.24 2.51-8.48 6H3l-1 2h4.06c-.04.33-.06.66-.06 1s.02.67.06 1H3l-1 2h4.52c1.24 3.49 4.56 6 8.48 6 2.31 0 4.41-.87 6-2.3l-1.78-1.77c-1.13.98-2.6 1.57-4.22 1.57z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Overzicht betalingen" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<TextBlock Classes="NavGroep" Text="ATELIER"/>
					<Button Command="{Binding OpenPlanningCommand}" Classes="NavButton" ToolTip.Tip="Planning">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Planning" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenLijstenCommand}" Classes="NavButton" ToolTip.Tip="Lijsten">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Lijsten" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenKantKlaarKaderenCommand}" Classes="NavButton" ToolTip.Tip="Standaardkaders">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M3 3v18h18V3H3zm16 16H5V5h14v14z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Standaardkaders" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenAfwerkingsOptiesCommand}" Classes="NavButton" ToolTip.Tip="Afwerkingen">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 16c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7zm1-11h-2v3H8v2h3v3h2v-3h3v-2h-3z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Afwerkingen" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<TextBlock Classes="NavGroep" Text="BEHEER"/>
					<Button Command="{Binding OpenKlantenCommand}" Classes="NavButton" ToolTip.Tip="Klanten">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Klanten" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenLeveranciersCommand}" Classes="NavButton" ToolTip.Tip="Leveranciers">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Leveranciers" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenExportCenterCommand}" Classes="NavButton" ToolTip.Tip="Excel export">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M5 20h14v-2H5m14-9h-4V3H9v6H5l7 7 7-7z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Excel export" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding OpenInstellingenCommand}" Classes="NavButton" ToolTip.Tip="Instellingen">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
							<TextBlock Classes="NavLabel" Text="Instellingen" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
                </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Classes="label Copyright" Text="© 2025 QuadroApp - Anthony Mohamed"
                           Foreground="{DynamicResource TextMutedOnDark}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="Inhoud" Spacing="20">

                <!-- Kop: begroeting + snelle knoppen -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Begroeting}" Classes="h1"/>
                        <TextBlock Text="{Binding DatumTekst}" Classes="body" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Classes="KopKnop Primair" Command="{Binding NieuweOfferteCommand}" Content="＋ Nieuwe offerte"/>
                        <Button Classes="KopKnop" Command="{Binding OpenWerkBonCommand}" Content="Werkbonnen"/>
                        <Button Classes="KopKnop" Command="{Binding OpenPlanningCommand}" Content="Planning"/>
                    </StackPanel>
                </Grid>

                <!-- US-86 — vandaag af te halen / nog te betalen; klik opent de offerte -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
				<Border Classes="Card Blok1">
					<Grid RowDefinitions="Auto,*">
						<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<TextBlock Text="Vandaag af te halen" Classes="h2"/>
								<Border Background="{DynamicResource StatBlueBg}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center" IsVisible="{Binding HeeftVandaagAfTeHalen}">
									<TextBlock Text="{Binding VandaagAantal}" Foreground="{DynamicResource StatBlueText}" FontWeight="Bold" FontSize="12"/>
								</Border>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HeeftVandaagAfTeHalen}">
								<TextBlock Text="nog te ontvangen" Classes="label" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding VandaagTotaalTekst}" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Grid>
						<TextBlock Grid.Row="1" Text="Niets gepland voor vandaag" IsVisible="{Binding !HeeftVandaagAfTeHalen}"
								   Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="2,4"/>
						<!-- Vaste hoogte: bij veel verkopen scrollen in het blok (US-105) -->
						<Border Grid.Row="1" Classes="Lijst" IsVisible="{Binding HeeftVandaagAfTeHalen}" VerticalAlignment="Top">
							<ScrollViewer MaxHeight="222" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding VandaagAfTeHalen}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="sv:VerkoopOverzichtRegel">
											<Button Classes="VerkoopRij"
													Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenVerkoopCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="{Binding BonTekst}">
												<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
													<TextBlock Text="{Binding KlantNaam}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
													<TextBlock Grid.Column="1" Text="{Binding BonTekst}" Classes="label RijBon" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
													<TextBlock Grid.Column="2" Text="{Binding StapKortTekst}" Classes="label RijStap" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
													<Border Grid.Column="3" Background="{DynamicResource StatBlueBg}" CornerRadius="10" Padding="8,2" MinWidth="92">
														<TextBlock Text="{Binding BedragTekst}" Foreground="{DynamicResource StatBlueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
													</Border>
												</Grid>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
					</Grid>
				</Border>
				<Border Classes="Card Blok2">
					<Grid RowDefinitions="Auto,*">
						<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<TextBlock Text="Nog te betalen" Classes="h2"/>
								<Border Background="{DynamicResource StatOrangeBg}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center" IsVisible="{Binding HeeftNogTeBetalen}">
									<TextBlock Text="{Binding NogTeBetalenAantal}" Foreground="{DynamicResource StatOrangeText}" FontWeight="Bold" FontSize="12"/>
								</Border>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HeeftNogTeBetalen}">
								<TextBlock Text="totaal" Classes="label" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding NogTeBetalenTotaalTekst}" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Grid>
						<TextBlock Grid.Row="1" Text="Alles is betaald" IsVisible="{Binding !HeeftNogTeBetalen}"
								   Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="2,4"/>
						<!-- Vaste hoogte: bij veel verkopen scrollen in het blok (US-105) -->
						<Border Grid.Row="1" Classes="Lijst" IsVisible="{Binding HeeftNogTeBetalen}" VerticalAlignment="Top">
							<ScrollViewer MaxHeight="222" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding NogTeBetalen}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="sv:VerkoopOverzichtRegel">
											<Button Classes="VerkoopRij"
													Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenVerkoopCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="{Binding BonTekst}">
												<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
													<TextBlock Text="{Binding KlantNaam}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
													<TextBlock Grid.Column="1" Text="{Binding BonTekst}" Classes="label RijBon" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
													<TextBlock Grid.Column="2" Text="{Binding AfhaalDatumTekst}" Classes="label RijStap" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
													<Border Grid.Column="3" Background="{DynamicResource StatOrangeBg}" CornerRadius="10" Padding="8,2" MinWidth="92">
														<TextBlock Text="{Binding BedragTekst}" Foreground="{DynamicResource StatOrangeText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
													</Border>
												</Grid>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
					</Grid>
				</Border>
                </Grid>

                <!-- Voorraad & leveringen: dichtgeklapt alleen de tellers; open = alle waarschuwingen (scrollen) -->
                <Border Classes="Card" Padding="0">
                    <StackPanel>
                        <Button Classes="VoorraadKop" Command="{Binding ToggleVoorraadCommand}" IsEnabled="{Binding HeeftWaarschuwingen}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <TextBlock Text="Voorraad &amp; leveringen" Classes="h2" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
									<Border Classes="Chip" Background="{DynamicResource StatRedBg}" IsVisible="{Binding LowStockCount}">
										<TextBlock Text="{Binding LageVoorraadTekst}" Foreground="{DynamicResource StatRedText}"/>
									</Border>
									<Border Classes="Chip" Background="{DynamicResource StatBlueBg}" IsVisible="{Binding OpenShortageCount}">
										<TextBlock Text="{Binding TekortTekst}" Foreground="{DynamicResource StatBlueText}"/>
									</Border>
									<Border Classes="Chip" Background="{DynamicResource StatPurpleBg}" IsVisible="{Binding OverdueOrderCount}">
										<TextBlock Text="{Binding TeLaatTekst}" Foreground="{DynamicResource StatPurpleText}"/>
									</Border>
									<Border Classes="Chip" Background="{DynamicResource StatOrangeBg}" IsVisible="{Binding PartialReceiptCount}">
										<TextBlock Text="{Binding DeelsOntvangenTekst}" Foreground="{DynamicResource StatOrangeText}"/>
									</Border>
                                    <Border Classes="Chip" Background="{DynamicResource SuccessBg}" IsVisible="{Binding !HeeftWaarschuwingen}">
                                        <TextBlock Text="Alles in orde" Foreground="{DynamicResource Success}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Grid.Column="2" Text="{Binding VoorraadKnopTekst}" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" IsVisible="{Binding HeeftWaarschuwingen}"/>
                            </Grid>
                        </Button>
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,6,18,10" IsVisible="{Binding ToonVoorraadLijst}">
                            <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Waarschuwingen}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WaarschuwingRegel">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,5">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Kleur}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Classes="WaarschuwingSoort" Text="{Binding Soort}" FontWeight="SemiBold" Width="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Bericht}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Wanneer}" Classes="label" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Snel naar -->
                <StackPanel Spacing="10">
                    <TextBlock Text="SNEL NAAR" Classes="label" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    <UniformGrid Classes="Tegels" Margin="0,0,-10,0">
					<Button Classes="Tegel" Command="{Binding OpenOffertesLijstCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconBlueBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" Fill="{DynamicResource IconBlue}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Offertes" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Prijs berekenen en opvolgen" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenPlanningCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconRoseBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" Fill="{DynamicResource IconRose}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Planning" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Werkbezetting" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenWinkelVerkopenCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconEmeraldBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.24-5.88c.09-.16.14-.35.14-.54 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" Fill="{DynamicResource IconEmerald}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Winkelverkopen" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Toonbankverkopen" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenOverzichtBetalingenCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconGreenBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M15 18.5c-2.51 0-4.68-1.42-5.76-3.5H15l1-2H8.58c-.05-.33-.08-.66-.08-1s.03-.67.08-1H16l1-2H9.24C10.32 6.92 12.5 5.5 15 5.5c1.61 0 3.09.59 4.23 1.57L21 5.3C19.41 3.87 17.3 3 15 3c-3.92 0-7.24 2.51-8.48 6H3l-1 2h4.06c-.04.33-.06.66-.06 1s.02.67.06 1H3l-1 2h4.52c1.24 3.49 4.56 6 8.48 6 2.31 0 4.41-.87 6-2.3l-1.78-1.77c-1.13.98-2.6 1.57-4.22 1.57z" Fill="{DynamicResource IconGreen}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Overzicht betalingen" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Per dag en betaalwijze" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenKlantenCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconGreenBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="{DynamicResource IconGreen}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Klanten" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Klantgegevens" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenLijstenCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconOrangeBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" Fill="{DynamicResource IconOrange}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Lijsten" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Type-lijsten en prijzen" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenKantKlaarKaderenCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconSlateBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M3 3v18h18V3H3zm16 16H5V5h14v14z" Fill="{DynamicResource IconSlate}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Standaardkaders" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="Kaders en prijzen" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
					<Button Classes="Tegel" Command="{Binding OpenFacturenCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Background="{DynamicResource IconPurpleBg}" CornerRadius="8" Width="36" Height="36">
								<Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="{DynamicResource IconPurple}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Bestelbonnen" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
								<TextBlock Text="De bon voor de klant" Classes="label" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Grid>
					</Button>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Styles>
        <!-- Zijbalk -->
        <Style Selector="Border.Zijbalk"><Setter Property="Width" Value="232"/></Style>
        <Style Selector="Border.Logo"><Setter Property="Width" Value="120"/></Style>
        <Style Selector="TextBlock.NavGroep">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedOnDark}"/>
            <Setter Property="Margin" Value="10,14,0,4"/>
        </Style>
        <Style Selector="Button.NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandDarkHover}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.NavButton.Actief /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandDarkHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandYellow}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>

        <!-- Inhoud -->
        <Style Selector="StackPanel.Inhoud"><Setter Property="Margin" Value="32,28"/></Style>
        <Style Selector="Button.KopKnop">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.KopKnop.Primair">
            <Setter Property="Background" Value="{DynamicResource BrandYellow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandYellow}"/>
        </Style>
        <Style Selector="Button.KopKnop:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandYellowHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandYellow}"/>
        </Style>

        <!-- Kolommen via stijlen (niet in de XAML), zodat de container queries ze kunnen aanpassen -->
        <Style Selector="UniformGrid.Tegels"><Setter Property="Columns" Value="4"/></Style>
        <Style Selector="Border.Blok1"><Setter Property="Margin" Value="0,0,10,0"/></Style>
        <Style Selector="Border.Blok2"><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="Grid.Column" Value="1"/></Style>
        <Style Selector="Border.Lijst">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Button.VerkoopRij">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.VerkoopRij:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandYellowHover}"/>
        </Style>

        <Style Selector="Button.VoorraadKop">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.VoorraadKop:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.VoorraadKop:disabled TextBlock.h2">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Border.Chip">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style Selector="Border.Chip > TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.Tegel">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.Tegel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandYellowHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandYellow}"/>
        </Style>

        <!-- Smaller venster (bv. laptop 1024 px): menu enkel iconen, blokken onder elkaar -->
        <ContainerQuery Name="home" Query="max-width:1180">
            <Style Selector="Border.Zijbalk"><Setter Property="Width" Value="64"/></Style>
            <Style Selector="Border.Logo"><Setter Property="Width" Value="40"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,4,0,14"/></Style>
            <Style Selector="TextBlock.NavLabel"><Setter Property="IsVisible" Value="False"/></Style>
            <Style Selector="TextBlock.NavGroep"><Setter Property="IsVisible" Value="False"/></Style>
            <Style Selector="TextBlock.Copyright"><Setter Property="IsVisible" Value="False"/></Style>
            <Style Selector="Button.NavButton"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
            <Style Selector="StackPanel.Inhoud"><Setter Property="Margin" Value="20,20"/></Style>
            <!-- Blokken onder elkaar -->
            <Style Selector="Border.Blok1"><Setter Property="Margin" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/></Style>
            <Style Selector="Border.Blok2">
                <Setter Property="Margin" Value="0,20,0,0"/>
                <Setter Property="Grid.Column" Value="0"/>
                <Setter Property="Grid.Row" Value="1"/>
                <Setter Property="Grid.ColumnSpan" Value="2"/>
            </Style>
            <Style Selector="TextBlock.RijStap"><Setter Property="IsVisible" Value="False"/></Style>
            <Style Selector="TextBlock.WaarschuwingSoort"><Setter Property="IsVisible" Value="False"/></Style>
        </ContainerQuery>
        <!-- Heel smal: twee tegels per rij, geen bonnummer in de rij -->
        <ContainerQuery Name="home" Query="max-width:820">
            <Style Selector="UniformGrid.Tegels"><Setter Property="Columns" Value="2"/></Style>
            <Style Selector="TextBlock.RijBon"><Setter Property="IsVisible" Value="False"/></Style>
        </ContainerQuery>
    </UserControl.Styles>
</UserControl>
