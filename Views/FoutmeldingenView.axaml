<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuadroApp.ViewModels.Gebruikers"
             x:Class="QuadroApp.Views.FoutmeldingenView"
             x:DataType="vm:FoutmeldingenViewModel">

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

		<TextBlock Grid.Row="0" Classes="h2" Text="Foutmeldingen" Margin="0,0,0,12"/>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
			<CheckBox Grid.Column="0" Content="Enkel niet bekeken"
					  IsChecked="{Binding EnkelNietBekeken}"/>
			<TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Margin="16,0,0,0"
					   Foreground="Firebrick" Text="{Binding Foutmelding}"/>
			<Button Grid.Column="2" Classes="GhostBtn" Content="Vernieuwen" Command="{Binding LadenCommand}"/>
		</Grid>

		<Grid Grid.Row="2" ColumnDefinitions="7*,12,4*">
			<Border Grid.Column="0" Classes="Card">
				<Grid>
					<DataGrid ItemsSource="{Binding Rijen}"
							  SelectedItem="{Binding Geselecteerd, Mode=TwoWay}"
							  IsReadOnly="True"
							  CanUserResizeColumns="True"
							  SelectionMode="Single"
							  GridLinesVisibility="Horizontal"
							  HeadersVisibility="Column">
						<DataGrid.Columns>
							<DataGridTemplateColumn Header="" Width="Auto">
								<DataTemplate x:DataType="vm:FoutmeldingRij">
									<Border IsVisible="{Binding IsNieuw}" Background="{DynamicResource BrandYellow}"
											CornerRadius="8" Padding="6,1" Margin="4,0" VerticalAlignment="Center">
										<TextBlock Text="nieuw" FontSize="11" Foreground="Black"/>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Tijdstip" Width="175" Binding="{Binding Tijdstip}"/>
							<DataGridTextColumn Header="Computer" Width="115" Binding="{Binding Computer}"/>
							<DataGridTextColumn Header="Scherm" Width="215" Binding="{Binding Scherm}"/>
							<DataGridTextColumn Header="Melding" Width="*" MinWidth="160" Binding="{Binding KorteMelding}"/>
						</DataGrid.Columns>
					</DataGrid>
					<TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
							   IsVisible="{Binding IsLeeg}" Text="{Binding LeegTekst}"/>
				</Grid>
			</Border>

			<Border Grid.Column="2" Classes="Card">
				<TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
						 FontFamily="Consolas,Menlo,monospace" FontSize="12"
						 ScrollViewer.HorizontalScrollBarVisibility="Auto"
						 ScrollViewer.VerticalScrollBarVisibility="Auto"
						 Text="{Binding DetailTekst, Mode=OneWay}"/>
			</Border>
		</Grid>

		<StackPanel x:Name="Knoppen" Grid.Row="3" Orientation="Horizontal" Spacing="8"
					HorizontalAlignment="Right" Margin="0,12,0,0">
			<Button Classes="GhostBtn" Content="Kopiëren" Command="{Binding KopieerCommand}"/>
			<Button Classes="AccentBtn" Content="Markeer als bekeken" Command="{Binding MarkeerBekekenCommand}"/>
		</StackPanel>
	</Grid>
</UserControl>
