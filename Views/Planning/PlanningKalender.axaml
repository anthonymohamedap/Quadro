<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QuadroApp.Views.Planning.PlanningKalender"
    xmlns:planning="clr-namespace:QuadroApp.Views.Planning"
    x:CompileBindings="False"
    Background="{DynamicResource SurfaceMuted}">

	<!-- US-92: de planningskalender als herbruikbaar blok (pagina Planning, stap 2 van het dossier,
	     en het venster dat de oude schermen nog gebruiken). Inhoud ongewijzigd uit PlanningCalendarWindow.
	     Huisstijl: uitsluitend theme-tokens (QuadroTheme.axaml). -->
	<UserControl.Styles>
		<StyleInclude Source="avares://QuadroApp/Views/Planning/PlanningStijlen.axaml"/>
	</UserControl.Styles>

	<Panel>
		<Grid RowDefinitions="Auto,Auto,*">

			<!-- ══════════════ TOOLBAR: maandnavigatie ══════════════ -->
			<Border Grid.Row="0"
					Background="{DynamicResource Surface}"
					BorderBrush="{DynamicResource BorderSubtle}"
					BorderThickness="0,0,0,1">
				<StackPanel Orientation="Horizontal"
							Spacing="8"
							Margin="20,10"
							VerticalAlignment="Center">
					<Button Content="←" Command="{Binding PrevMonthCommand}" Classes="MainBtn"/>
					<TextBlock Text="{Binding MonthTitle}"
							   Classes="h3"
							   MinWidth="150"
							   TextAlignment="Center"
							   VerticalAlignment="Center"/>
					<Button Content="→" Command="{Binding NextMonthCommand}" Classes="MainBtn"/>
					<Button Content="Vandaag"
							Command="{Binding TodayCommand}"
							Classes="GhostBtn"
							Margin="8,0,0,0"/>
				</StackPanel>
			</Border>

			<!-- ══════════════ BODY: 2-column ══════════════ -->
			<!-- US-49 Fase A: dashboard-KPI's + capaciteitslegende -->
			<Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,12">
				<planning:PlanningKpiBalk/>
			</Border>

			<Grid Grid.Row="2" ColumnDefinitions="*,Auto">

				<!-- LEFT — Calendar grid -->
				<Grid Grid.Column="0"
					  RowDefinitions="Auto,*"
					  Margin="16,16,16,8">

					<!-- Weekday headers -->
					<ItemsControl Grid.Row="0" ItemsSource="{Binding WeekHeaders}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="7"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}"
										   HorizontalAlignment="Center"
										   Classes="caption"
										   FontWeight="SemiBold"
										   Margin="0,0,0,8"
										   TextTrimming="CharacterEllipsis"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- Month day grid -->
					<ListBox Grid.Row="1" ItemsSource="{Binding MonthDays}">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="7"/>
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Classes="DayTile"
										Classes.weekend="{Binding IsWeekend}"
										Classes.otherMonth="{Binding IsOtherMonth}"
										Classes.today="{Binding IsToday}"
										Classes.blocked="{Binding IsGeblokkeerd}"
										Classes.selected="{Binding IsSelected}"
										Margin="3"
										Padding="10,8"
										MinHeight="80"
										Cursor="Hand"
										PointerPressed="DayTile_PointerPressed"
										DragDrop.AllowDrop="True">

									<StackPanel Spacing="4">
										<!-- Day number + blok-badge + bezettings-% -->
										<Grid ColumnDefinitions="Auto,*,Auto">
											<Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Danger}" IsVisible="{Binding IsGeblokkeerd}" VerticalAlignment="Center" Margin="0,0,5,0"/>
											<TextBlock Grid.Column="1" Text="{Binding DayNumber}" Classes="body" FontWeight="Bold"/>
											<TextBlock Grid.Column="2" Text="{Binding BusyPct}" Classes="caption" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
										</Grid>

										<!-- Capacity bar (proportioneel — schaalt mee met de tegel) -->
										<ProgressBar Classes="Capacity"
													 Classes.capLow="{Binding CapLow}"
													 Classes.capMid="{Binding CapMid}"
													 Classes.capHigh="{Binding CapHigh}"
													 Classes.capFull="{Binding CapFull}"
													 Value="{Binding Busy}"/>

										<!-- Hours / blocked label -->
										<TextBlock Text="{Binding BusyLabel}"
												   Classes="caption"
												   TextTrimming="CharacterEllipsis"
												   ToolTip.Tip="{Binding BusyLabel}"/>
										<TextBlock Text="{Binding TakenPreview}"
											   Classes="caption"
											   Foreground="{DynamicResource TextSecondary}"
											   TextTrimming="CharacterEllipsis"
											   ToolTip.Tip="{Binding TakenPreview}"
											   IsVisible="{Binding TakenPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>

				<!-- RIGHT PANEL -->
				<Border Grid.Column="1"
						MinWidth="380"
						MaxWidth="460"
						Background="{DynamicResource Surface}"
						BorderBrush="{DynamicResource BorderSubtle}"
						BorderThickness="1,0,0,0"
						Padding="20,16">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled"
								  VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="0">

							<planning:PlanningDagDetails/>

							<Rectangle Classes="Divider" Margin="0,4,0,14"/>

							<!-- ══ PLAN REGELS (contextueel) ══ -->

							<!-- No-werkbon hint -->
							<Border IsVisible="{Binding GeenWerkBon}"
									Background="{DynamicResource InfoBg}"
									BorderBrush="{DynamicResource InfoBorder}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="14,12"
									Margin="0,0,0,16">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock Text="" Classes="h3" VerticalAlignment="Center"/>
									<TextBlock Text="Open planning vanuit een werkbon om regels te kunnen plannen."
											   Classes="label"
											   Foreground="{DynamicResource InfoText}"
											   TextWrapping="Wrap"
											   VerticalAlignment="Center"/>
								</StackPanel>
							</Border>

							<!-- Werkbon regels panel -->
							<StackPanel IsVisible="{Binding HeeftWerkBon}"
										Spacing="10"
										Margin="0,0,0,16">
								<TextBlock Text="WERKBON REGELS" Classes="caption" FontWeight="SemiBold"/>
								<TextBlock Text="Sleep een regel op een dag, of vink aan en klik 'Plan op geselecteerde dag'." Classes="caption" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2"/>

								<ListBox ItemsSource="{Binding RegelsVanWerkBon}"
										 Background="{DynamicResource SurfaceMutedAlt}"
										 CornerRadius="8"
										 Padding="8">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,3" PointerPressed="Regel_PointerPressed">
												<Grid ColumnDefinitions="Auto,Auto,*,Auto">
													<CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
													<PathIcon Grid.Column="1" Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"/>
													<StackPanel Grid.Column="2" Spacing="2" Cursor="Hand">
														<TextBlock Text="{Binding Titel}" Classes="body" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Titel}"/>
														<TextBlock Text="{Binding LijstLabel}" Classes="caption" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LijstLabel}"/>
														<TextBlock Text="{Binding Afmeting}" Classes="caption" Foreground="{DynamicResource TextSecondary}"/>
													</StackPanel>
													<TextBlock Grid.Column="3" Text="sleep →" Classes="caption" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

								<Button Content="Plan op geselecteerde dag"
										Command="{Binding PlanGeselecteerdeRegelsCommand}"
										Classes="AccentBtn"
										Padding="12,8"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Center"/>

								<!-- US-21: aparte datum per inlijsting -->
								<Button Content="Plan per regel (aparte datums)"
										Command="{Binding PlanPerRegelCommand}"
										Classes="GhostBtn"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Center"/>
							</StackPanel>

							<Rectangle Classes="Divider" Margin="0,0,0,14"/>

							<planning:PlanningWeekDetail/>

							<Rectangle Classes="Divider" Margin="0,14,0,14"/>

							<planning:PlanningBlokkeren/>

						</StackPanel>
					</ScrollViewer>
				</Border>
			</Grid>

		</Grid>

		<!-- ══════════════ TOAST OVERLAY (bovenaan, zoals WeekWerkLijst) ══════════════ -->
		<ItemsControl ItemsSource="{Binding ToastMessages}"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Top"
					  Margin="0,14,0,0"
					  IsHitTestVisible="False">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Spacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Padding="14,10"
							CornerRadius="8"
							Background="{Binding BackgroundBrush}"
							BorderBrush="{DynamicResource BrandDark}"
							BorderThickness="1"
							MinWidth="220"
							MaxWidth="340">
						<TextBlock Text="{Binding Message}"
								   Classes="body"
								   Foreground="{DynamicResource TextOnDark}"
								   FontWeight="SemiBold"
								   TextWrapping="Wrap"/>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Panel>
</UserControl>
