<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:QuadroApp.ViewModels"
    xmlns:controls="clr-namespace:QuadroApp.Views.Controls"
    xmlns:planning="clr-namespace:QuadroApp.Views.Planning"
    x:Class="QuadroApp.Views.Planning.PlanningPaginaView"
    x:DataType="vm:PlanningPaginaViewModel"
    Background="{DynamicResource SurfaceMuted}">

    <!-- US-92: Planning als pagina (K14). -->
    <Grid RowDefinitions="Auto,*">
        <controls:QuadroHeader Title="PLANNING" BackCommand="{Binding GaTerugCommand}"/>
        <!-- US-92: dezelfde opmaak als stap 2 van het dossier (Anthony 05/11: "overal de nieuwe") -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <planning:WerkbonPlanner Margin="24,16" DataContext="{Binding Planner}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
