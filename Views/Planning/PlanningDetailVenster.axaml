<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QuadroApp.Views.Planning.PlanningDetailVenster"
    Width="560"
    Height="640"
    MinWidth="420"
    MinHeight="320"
    Background="{DynamicResource SurfaceMutedAlt}"
    WindowStartupLocation="CenterOwner">

    <!-- Dagdetail of weekdetail van de planning in een eigen venster (niet modaal): het blijft open en
         volgt de gekozen dag in de planner. DataContext = PlanningCalendarViewModel. -->
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Margin="16" Padding="16" CornerRadius="12"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <ContentControl x:Name="Inhoud"/>
            </Border>
        </ScrollViewer>
        <Button Grid.Row="1" Content="Sluiten" HorizontalAlignment="Right" Margin="16,0,16,16"
                Padding="16,6" CornerRadius="6" Click="Sluiten_Click"/>
    </Grid>
</Window>
