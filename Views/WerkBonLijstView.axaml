<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:QuadroApp.Views.Controls"
    xmlns:vm="using:QuadroApp.ViewModels"
    xmlns:m="clr-namespace:QuadroApp.Model.DB;assembly=QuadroApp.Data"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="using:QuadroApp.Converters"
    x:Class="QuadroApp.Views.WerkBonLijstView"
    x:Name="Root"
    x:DataType="vm:WerkBonLijstViewModel"
    d:DataContext="{d:DesignInstance vm:WerkBonLijstViewModel, IsDesignTimeCreatable=True}"
    Background="{DynamicResource SurfaceMuted}">

	<!-- Resources -->
	<UserControl.Resources>
		<conv:JaarConverter x:Key="JaarConv"/>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto,*">

		<!-- HEADER -->
		<controls:QuadroHeader Grid.Row="0" Title="WERKBONNEN" BackCommand="{Binding GaTerugCommand}"/>

		<!-- MAIN -->
		<Grid Grid.Row="1"
			  Margin="20">

			<!-- LINKS -->
			<ScrollViewer
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">

				<StackPanel Spacing="14">

					<TextBlock Text="Werkbonnen"
							   Classes="h1"/>

					<!-- Search + tools -->
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

						<StackPanel Grid.Column="0"
									Orientation="Horizontal"
									Spacing="8"
									VerticalAlignment="Center">
							<TextBox MinWidth="180"
									 Foreground="{DynamicResource TextPrimary}"
									 Watermark="Zoek op bonnr of klant…"
									 Text="{Binding Zoekterm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
							<ComboBox ItemsSource="{Binding BeschikbareJaren}"
									  SelectedItem="{Binding GeselecteerdJaar, Mode=TwoWay}"
									  MinWidth="100"
									  VerticalAlignment="Center">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={StaticResource JaarConv}}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<ComboBox ItemsSource="{Binding StatusFilterOpties}"
									  SelectedItem="{Binding GeselecteerdeStatusFilter, Mode=TwoWay}"
									  MinWidth="140"
									  VerticalAlignment="Center">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Label}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>

						<StackPanel Grid.Column="1"
									Orientation="Horizontal"
									Spacing="6"
									VerticalAlignment="Center">
							<Button ToolTip.Tip="Ververs" Command="{Binding RefreshCommand}" Classes="MainBtn"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="Ververs" VerticalAlignment="Center"/></StackPanel></Button>
							<Button ToolTip.Tip="Planning openen" Command="{Binding OpenPlanningCommand}" Classes="MainBtn"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="Planning openen" VerticalAlignment="Center"/></StackPanel></Button>
						</StackPanel>

					</Grid>

					<!-- Werkbonnen-lijst (kaarten) -->
					<Border Background="{DynamicResource Surface}"
							BorderBrush="{DynamicResource BorderSubtle}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="6">

						<ListBox ItemsSource="{Binding WerkBonnen}"
								 SelectedItem="{Binding SelectedWerkBon, Mode=TwoWay}"
								 BorderThickness="0"
								 Background="Transparent">

							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="m:WerkBon">
									<Border Background="{DynamicResource Surface}"
											BorderBrush="{DynamicResource BorderSubtle}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="12,10"
											Margin="0,3">
										<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">

											<!-- Bon-nr + status-badge -->
											<StackPanel Grid.Column="0" Spacing="5" MinWidth="72" VerticalAlignment="Center">
												<TextBlock Text="{Binding Id, StringFormat='Bon #{0}'}" FontWeight="Bold"/>
												<Border Background="{Binding Status, Converter={x:Static conv:WerkBonStatusToBrushConverter.Instance}}"
														CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
													<TextBlock Text="{Binding Status, Converter={x:Static conv:WerkBonStatusToLabelConverter.Instance}}"
															   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
												</Border>
											</StackPanel>

											<!-- Klant + meta -->
											<StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
												<TextBlock Text="{Binding Offerte.Klant.VolledigeNaam}"
														   FontWeight="SemiBold"
														   TextTrimming="CharacterEllipsis"
														   ToolTip.Tip="{Binding Offerte.Klant.VolledigeNaam}"/>
												<StackPanel Orientation="Horizontal" Spacing="6">
													<TextBlock Text="{Binding OfferteId, StringFormat='Offerte #{0}'}"
															   Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
													<TextBlock Text="·" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
													<TextBlock Text="{Binding AantalTaken, StringFormat='{}{0} taken'}"
															   Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
												</StackPanel>
												<TextBlock Text="{Binding BestelVoortgangLabel}"
														   Foreground="{DynamicResource TextSecondary}" FontSize="12"
														   IsVisible="{Binding BestelVoortgangLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
											</StackPanel>

											<!-- Totaal + datums -->
											<StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
												<TextBlock Text="{Binding TotaalPrijsIncl, StringFormat='€ {0:N2}'}"
														   FontWeight="Bold" HorizontalAlignment="Right"/>
												<TextBlock Text="{Binding AangemaaktOp, StringFormat='Aangemaakt {0:dd/MM/yyyy}'}"
														   Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
												<TextBlock Text="{Binding AfhaalDatum, StringFormat='Ophalen {0:dd/MM/yyyy}'}"
														   Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"
														   IsVisible="{Binding AfhaalDatum, Converter={x:Static ObjectConverters.IsNotNull}}"/>
											</StackPanel>

											<!-- Actie -->
											<Button Grid.Column="3"
													Content="Open werkbon"
													Classes="AccentBtn"
													Padding="10,6"
													Cursor="Hand"
													VerticalAlignment="Center"
													Command="{Binding #Root.((vm:WerkBonLijstViewModel)DataContext).OpenWerkBonDetailCommand}"
													CommandParameter="{Binding}"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>

						</ListBox>
					</Border>

					<TextBlock Text="{Binding WerkBonnen.Count, StringFormat='Aantal werkbonnen: {0}'}"
							   Foreground="{DynamicResource TextPrimary}"
							   HorizontalAlignment="Center"/>

				</StackPanel>
			</ScrollViewer>

		</Grid>
	</Grid>


</UserControl>
