<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:QuadroApp.Views.Controls"
    xmlns:vm="using:QuadroApp.ViewModels"
    xmlns:m="using:QuadroApp.Model.DB"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="using:QuadroApp.Converters"
    x:Class="QuadroApp.Views.WerkBonLijstView"
    x:Name="Root"
    x:DataType="vm:WerkBonLijstViewModel"
    d:DataContext="{d:DesignInstance vm:WerkBonLijstViewModel, IsDesignTimeCreatable=True}"
    Background="{DynamicResource SurfaceMuted}">

	<!-- Resources -->
	<UserControl.Resources>
		<conv:JaarConverter x:Key="JaarConv"/>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto,*">

		<!-- HEADER -->
		<controls:QuadroHeader Grid.Row="0" Title="WERKBONNEN" BackCommand="{Binding GaTerugCommand}"/>

		<!-- MAIN -->
		<Grid Grid.Row="1"
			  Margin="20"
			  ColumnDefinitions="*,Auto"
			  ColumnSpacing="20">

			<!-- LINKS -->
			<ScrollViewer Grid.Column="0"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">

				<StackPanel Spacing="14">

					<TextBlock Text="🧾 Werkbonnen"
							   Classes="h1"/>

					<!-- Search + tools -->
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

						<StackPanel Grid.Column="0"
									Orientation="Horizontal"
									Spacing="8"
									VerticalAlignment="Center">
							<TextBox MinWidth="180"
									 Foreground="{DynamicResource TextPrimary}"
									 Watermark="Zoek op bonnr of klant…"
									 Text="{Binding Zoekterm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
							<ComboBox ItemsSource="{Binding BeschikbareJaren}"
									  SelectedItem="{Binding GeselecteerdJaar, Mode=TwoWay}"
									  MinWidth="100"
									  VerticalAlignment="Center">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={StaticResource JaarConv}}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<ComboBox ItemsSource="{Binding StatusFilterOpties}"
									  SelectedItem="{Binding GeselecteerdeStatusFilter, Mode=TwoWay}"
									  MinWidth="140"
									  VerticalAlignment="Center">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Label}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>

						<StackPanel Grid.Column="1"
									Orientation="Horizontal"
									Spacing="6"
									VerticalAlignment="Center">
							<Button Content="🔄 Ververs"
									ToolTip.Tip="Ververs"
									Command="{Binding RefreshCommand}"
									Classes="MainBtn"/>
							<Button Content="📅 Planning openen"
									ToolTip.Tip="Planning openen"
									Command="{Binding OpenPlanningCommand}"
									Classes="MainBtn"/>
						</StackPanel>

					</Grid>

					<!-- Werkbonnen-lijst (kaarten) -->
					<Border Background="{DynamicResource Surface}"
							BorderBrush="{DynamicResource BorderSubtle}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="6">

						<ListBox ItemsSource="{Binding WerkBonnen}"
								 SelectedItem="{Binding SelectedWerkBon, Mode=TwoWay}"
								 BorderThickness="0"
								 Background="Transparent">

							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="m:WerkBon">
									<Border Background="{DynamicResource Surface}"
											BorderBrush="{DynamicResource BorderSubtle}"
											BorderThickness="1"
											CornerRadius="8"
											Padding="12,10"
											Margin="0,3">
										<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">

											<!-- Bon-nr + status-badge -->
											<StackPanel Grid.Column="0" Spacing="5" MinWidth="72" VerticalAlignment="Center">
												<TextBlock Text="{Binding Id, StringFormat='Bon #{0}'}" FontWeight="Bold"/>
												<Border Background="{Binding Status, Converter={x:Static conv:WerkBonStatusToBrushConverter.Instance}}"
														CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
													<TextBlock Text="{Binding Status, Converter={x:Static conv:WerkBonStatusToLabelConverter.Instance}}"
															   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
												</Border>
											</StackPanel>

											<!-- Klant + meta -->
											<StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
												<TextBlock Text="{Binding Offerte.Klant.VolledigeNaam}"
														   FontWeight="SemiBold"
														   TextTrimming="CharacterEllipsis"
														   ToolTip.Tip="{Binding Offerte.Klant.VolledigeNaam}"/>
												<StackPanel Orientation="Horizontal" Spacing="6">
													<TextBlock Text="{Binding OfferteId, StringFormat='Offerte #{0}'}"
															   Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
													<TextBlock Text="·" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
													<TextBlock Text="{Binding AantalTaken, StringFormat='{}{0} taken'}"
															   Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
												</StackPanel>
												<TextBlock Text="{Binding BestelVoortgangLabel}"
														   Foreground="{DynamicResource TextSecondary}" FontSize="12"
														   IsVisible="{Binding BestelVoortgangLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
											</StackPanel>

											<!-- Totaal + datums -->
											<StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
												<TextBlock Text="{Binding TotaalPrijsIncl, StringFormat='€ {0:N2}'}"
														   FontWeight="Bold" HorizontalAlignment="Right"/>
												<TextBlock Text="{Binding AangemaaktOp, StringFormat='Aangemaakt {0:dd/MM/yyyy}'}"
														   Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
												<TextBlock Text="{Binding AfhaalDatum, StringFormat='Ophalen {0:dd/MM/yyyy}'}"
														   Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"
														   IsVisible="{Binding AfhaalDatum, Converter={x:Static ObjectConverters.IsNotNull}}"/>
											</StackPanel>

											<!-- Actie -->
											<Button Grid.Column="3"
													Content="Open werkbon"
													Classes="AccentBtn"
													Padding="10,6"
													Cursor="Hand"
													VerticalAlignment="Center"
													Command="{Binding #Root.((vm:WerkBonLijstViewModel)DataContext).SelecteerWerkBonCommand}"
													CommandParameter="{Binding}"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>

						</ListBox>
					</Border>

					<TextBlock Text="{Binding WerkBonnen.Count, StringFormat='Aantal werkbonnen: {0}'}"
							   Foreground="{DynamicResource TextPrimary}"
							   HorizontalAlignment="Center"/>

				</StackPanel>
			</ScrollViewer>

			<!-- DETAIL PANEL: lege staat -->
			<Border Grid.Column="1"
					MinWidth="240"
					MaxWidth="300"
					Padding="24"
					Background="{DynamicResource Surface}"
					CornerRadius="10"
					BorderBrush="{DynamicResource BorderSubtle}"
					BorderThickness="1"
					IsVisible="{Binding !IsDetailOpen}"
					VerticalAlignment="Top">
				<StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
					<TextBlock Text="📋" Classes="iconLarge" HorizontalAlignment="Center"/>
					<TextBlock Text="Klik op '👁 Bekijk' naast een werkbon om de details te openen."
							   Foreground="{DynamicResource TextSecondary}"
							   TextWrapping="Wrap"
							   TextAlignment="Center"
							   Classes="body"/>
				</StackPanel>
			</Border>

			<!-- DETAIL PANEL: geselecteerde werkbon -->
			<Border Grid.Column="1"
					MinWidth="360"
					MaxWidth="520"
					Padding="24"
					Background="{DynamicResource Surface}"
					CornerRadius="10"
					BorderBrush="{DynamicResource BorderSubtle}"
					BorderThickness="1"
					IsVisible="{Binding IsDetailOpen}">

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="14">

						<DockPanel>
							<Button DockPanel.Dock="Right"
									Content="✕ Sluiten"
									Command="{Binding SluitDetailCommand}"
									Background="Transparent"
									Foreground="{DynamicResource TextSecondary}"
									Padding="6,4"
									VerticalAlignment="Center"
									HorizontalAlignment="Right"/>
							<TextBlock Text="📌 Werkbon details"
									   Classes="h1"
									   TextTrimming="CharacterEllipsis"
									   VerticalAlignment="Center"/>
						</DockPanel>

						<!-- Details -->
						<StackPanel Spacing="16">

							<Grid ColumnDefinitions="2*,3*"
								  RowDefinitions="Auto,Auto,Auto,Auto"
								  RowSpacing="7"
								  ColumnSpacing="14">

								<TextBlock Text="Bon nr."
										   Grid.Row="0" Grid.Column="0"
										   FontWeight="Bold"/>
								<TextBlock Text="{Binding SelectedWerkBon.Id}"
										   Grid.Row="0" Grid.Column="1"/>

								<TextBlock Text="Klant"
										   Grid.Row="1" Grid.Column="0"
										   FontWeight="Bold"/>
								<TextBlock Text="{Binding SelectedWerkBon.Offerte.Klant.Achternaam}"
										   ToolTip.Tip="{Binding SelectedWerkBon.Offerte.Klant.Achternaam}"
										   TextTrimming="CharacterEllipsis"
										   Grid.Row="1" Grid.Column="1"/>

								<TextBlock Text="Werkbon status"
										   Grid.Row="2" Grid.Column="0"
										   FontWeight="Bold"/>
								<ComboBox Grid.Row="2" Grid.Column="1"
										  ItemsSource="{Binding WerkBonStatusOpties}"
										  SelectedItem="{Binding SelectedWerkBonStatus, Mode=TwoWay}"/>

							</Grid>

							<WrapPanel HorizontalAlignment="Right">
								<Button Content="📄 Open bestelbon"
										Command="{Binding OpenBestelBonCommand}"
										Background="{DynamicResource InfoBg}"
										Foreground="{DynamicResource InfoText}"
										FontWeight="Bold"
										CornerRadius="6"
										Padding="12,6"
										Margin="0,0,10,6"/>
								<Button Content="💾 Opslaan status"
										Command="{Binding SaveStatusCommand}"
										Classes="MainBtn"
										Padding="12,6"
										Margin="0,0,0,6"/>
							</WrapPanel>

							<TextBlock Text="Werktaken"
									   Classes="h2"/>

							<Border Background="{DynamicResource SurfaceMutedAlt}"
									BorderBrush="{DynamicResource BorderSubtle}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="6">

								<ListBox ItemsSource="{Binding SelectedWerkBonTaken}"
										 BorderThickness="0"
										 Background="Transparent">
									<ListBox.ItemTemplate>
										<DataTemplate x:DataType="m:WerkTaak">
											<Border Background="{DynamicResource Surface}"
													CornerRadius="8"
													BorderBrush="{DynamicResource BorderSubtle}"
													BorderThickness="1"
													Padding="10"
													Margin="0,0,0,8">
												<StackPanel Spacing="6">
													<!-- Vaste info -->
													<TextBlock Text="{Binding Omschrijving}"
															   FontWeight="Bold"
															   Foreground="{DynamicResource TextPrimary}"
															   TextTrimming="CharacterEllipsis"
															   ToolTip.Tip="{Binding Omschrijving}"/>
													<TextBlock Text="{Binding DuurMinuten, StringFormat='Duur: {0} min'}" Foreground="{DynamicResource TextSecondary}"/>
													<TextBlock Text="{Binding GeplandVan, StringFormat='Van: {0:dd/MM HH:mm}'}" Foreground="{DynamicResource TextSecondary}"/>
													<TextBlock Text="{Binding GeplandTot, StringFormat='Tot: {0:dd/MM HH:mm}'}" Foreground="{DynamicResource TextSecondary}"/>
													<TextBlock Text="{Binding OfferteRegel.TypeLijst.Artikelnummer, StringFormat='Lijst: {0}'}"
															   Foreground="{DynamicResource TextSecondary}"
															   TextTrimming="CharacterEllipsis"
															   ToolTip.Tip="{Binding OfferteRegel.TypeLijst.Artikelnummer}"/>
													<TextBlock Text="{Binding OfferteRegel.AfwerkingSamenvatting, StringFormat='Afwerking: {0}'}"
															   Foreground="{DynamicResource TextSecondary}"
															   TextWrapping="Wrap"
															   ToolTip.Tip="{Binding OfferteRegel.AfwerkingSamenvatting}"
															   IsVisible="{Binding OfferteRegel.AfwerkingSamenvatting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

													<!-- US-51: één status-chip (elkaar uitsluitend) -->
													<Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
															Background="{DynamicResource SuccessBg}" IsVisible="{Binding IsBesteld}">
														<TextBlock Foreground="{DynamicResource Success}" FontWeight="SemiBold"
																   Text="{Binding BestelDatum, StringFormat='Besteld op {0:dd/MM/yyyy}'}"/>
													</Border>
													<Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
															Background="{DynamicResource SuccessBg}" IsVisible="{Binding IsOpVoorraad}">
														<TextBlock Text="Op voorraad — geen bestelling nodig"
																   Foreground="{DynamicResource Success}" FontWeight="SemiBold" TextWrapping="Wrap"/>
													</Border>

													<!-- US-51: bestelblok enkel als er écht besteld moet worden -->
													<StackPanel Spacing="6" IsVisible="{Binding MoetBesteldWorden}">
														<Border Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
															<TextBlock Text="Te bestellen" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/>
														</Border>
														<StackPanel Orientation="Horizontal" Spacing="8">
															<TextBlock Text="Bestelwijze" VerticalAlignment="Center" Classes="caption"/>
															<ComboBox MinWidth="150"
																	  ItemsSource="{Binding BestelVormOpties}"
																	  SelectedItem="{Binding GeselecteerdeBestelVorm, Mode=TwoWay}">
																<ComboBox.ItemTemplate>
																	<DataTemplate x:DataType="m:BestelVorm">
																		<TextBlock Text="{Binding Converter={x:Static conv:BestelVormToLabelConverter.Instance}}"/>
																	</DataTemplate>
																</ComboBox.ItemTemplate>
															</ComboBox>
														</StackPanel>
														<Button Content="Bestelling plaatsen"
																Classes="AccentBtn"
																HorizontalAlignment="Left"
																Command="{Binding #Root.((vm:WerkBonLijstViewModel)DataContext).MarkeerLijstAlsBesteldCommand}"
																CommandParameter="{Binding}"/>
													</StackPanel>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</Border>

						</StackPanel>

					</StackPanel>
				</ScrollViewer>
			</Border>

		</Grid>
	</Grid>


</UserControl>
