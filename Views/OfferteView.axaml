<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:QuadroApp.ViewModels"
    xmlns:m="clr-namespace:QuadroApp.Model.DB;assembly=QuadroApp.Data"
    xmlns:conv="clr-namespace:QuadroApp.Converters"
    xmlns:controls="clr-namespace:QuadroApp.Views.Controls"
    xmlns:offerte="clr-namespace:QuadroApp.Views.Offerte"
    x:Class="QuadroApp.Views.OfferteView"
    x:DataType="vm:OfferteViewModel">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          Background="{DynamicResource SurfaceMutedAlt}"
          TextElement.Foreground="{DynamicResource TextPrimary}">

		<!-- ================= HEADER ================= -->
		<controls:QuadroHeader Grid.Row="0" Title="OFFERTEBEHEER" BackCommand="{Binding GaTerugCommand}"/>

		<!-- ================= COMPACTE SAMENVATTING (sticky) ================= -->
		<Border Grid.Row="1"
				Background="{DynamicResource Surface}"
				BorderBrush="{DynamicResource BorderSubtle}"
				BorderThickness="0,0,0,1"
				Padding="24,10">
			<StackPanel Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
				<StackPanel Spacing="1">
					<TextBlock Text="Offerte" Classes="caption" Foreground="{DynamicResource TextSecondary}"/>
					<TextBlock Text="{Binding OfferteNummerTekst}" FontWeight="SemiBold"
							   ToolTip.Tip="Een nieuwe offerte krijgt haar nummer bij de eerste keer opslaan of afdrukken."/>
				</StackPanel>
				<StackPanel Spacing="1">
					<TextBlock Text="Klant" Classes="caption" Foreground="{DynamicResource TextSecondary}"/>
					<TextBlock Text="{Binding SelectedKlant.Achternaam, TargetNullValue='—'}"
							   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
							   MaxWidth="220" ToolTip.Tip="{Binding SelectedKlant.Achternaam}"/>
				</StackPanel>
				<StackPanel Spacing="1">
					<TextBlock Text="Regels" Classes="caption" Foreground="{DynamicResource TextSecondary}"/>
					<TextBlock Text="{Binding Regels.Count}" FontWeight="SemiBold"/>
				</StackPanel>
				<StackPanel Spacing="1">
					<TextBlock Text="Totaal incl." Classes="caption" Foreground="{DynamicResource TextSecondary}"/>
					<TextBlock Text="{Binding OfferteIncl, StringFormat=€ {0:N2}}" FontWeight="SemiBold"/>
				</StackPanel>
				<StackPanel Spacing="1">
					<TextBlock Text="Afhalen" Classes="caption" Foreground="{DynamicResource TextSecondary}"/>
					<TextBlock Text="{Binding Offerte.AfhaalDatum, StringFormat='{}{0:dd-MM-yyyy}', TargetNullValue='—'}"
							   FontWeight="SemiBold"/>
				</StackPanel>
				<Border CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
						Background="{Binding Offerte.Status, Converter={x:Static conv:OfferteStatusToBrushConverter.Instance}}"
						IsVisible="{Binding Offerte, Converter={x:Static ObjectConverters.IsNotNull}}">
					<TextBlock Text="{Binding Offerte.Status, Converter={x:Static conv:StatusLabelConverter.Instance}}"
							   Foreground="White" FontWeight="SemiBold" FontSize="12"/>
				</Border>
			</StackPanel>
		</Border>

		<!-- ================= STAPPENBALK (US-83) ================= -->
		<controls:StappenBalk Grid.Row="2" DataContext="{Binding Workflow.StappenBalk}"/>

		<!-- ================= BODY ================= -->
		<Grid Grid.Row="3"
                  Margin="24"
                  ColumnDefinitions="1*,1.05*"
                  ColumnSpacing="24">

				<!-- ===== RECHTS: klant + regeloverzicht (eigen scroll) ===== -->
				<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="20">

					<!-- KLANT (US-91: eigen control) -->
					<offerte:OfferteKlantKaart/>

					<!-- REGELS (US-91: eigen control) -->
					<offerte:OfferteRegelsKaart/>

				</StackPanel>
				</ScrollViewer>

				<!-- ===== LINKS: regel bewerken (eigen scroll) ===== -->
				<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<!-- US-101: bij een afgeronde verkoop alleen-lezen (scrollen blijft mogelijk) -->
				<StackPanel IsEnabled="{Binding KanBewerken}"
                            Spacing="20">

					<!-- REGEL DETAILS, AFWERKINGEN, CODE (US-91: eigen control) -->
					<offerte:OfferteRegelEditor/>
					<!-- PRIJSAANPASSINGEN + VOORSCHOT (US-91: eigen control) -->
					<offerte:OffertePrijsKaart/>
				</StackPanel>
				</ScrollViewer>
			</Grid>

		<!-- ================= STICKY FOOTER ================= -->
		<Border Grid.Row="4"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="16">
			<Grid ColumnDefinitions="*,Auto"
				  ColumnSpacing="30">

				<!-- LINKS ACTIES -->
				<StackPanel Spacing="6">
					<!-- US-101: afgeronde verkoop is vergrendeld -->
					<Border Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1"
							CornerRadius="6" Padding="10,6" IsVisible="{Binding IsAlleenLezen}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Success}" FontWeight="SemiBold"
									   Text="Afgehaald en volledig betaald: deze verkoop is afgerond en kan niet meer gewijzigd worden."/>
							<Button Content="Ontgrendelen" Classes="GhostBtn" Padding="10,4"
									Command="{Binding OntgrendelenCommand}"
									IsVisible="{Binding IsOntgrendelenZichtbaar}"
									ToolTip.Tip="Enkel voor een beheerder: om een fout recht te zetten"/>
						</StackPanel>
					</Border>
					<!-- US-100: prijs vast sinds de bevestiging -->
					<TextBlock IsVisible="{Binding IsPrijsVastMeldingZichtbaar}" Classes="caption" Foreground="{DynamicResource TextSecondary}"
							   TextWrapping="Wrap"
							   Text="De klant heeft bevestigd: de prijzen staan vast en worden niet meer automatisch herberekend."/>
					<WrapPanel>

						<Button Content="{Binding BerekenKnopTekst}"
								Command="{Binding BerekenCommand}"
								IsEnabled="{Binding !IsAlleenLezen}"
								Classes="GhostBtn"
								Margin="0,0,12,6"
								ToolTip.Tip="Na de bevestiging door de klant staan de prijzen vast; herberekenen gebeurt enkel nog op jouw vraag."/>

						<Button Content="Opslaan"
								Command="{Binding SaveCommand}"
								IsEnabled="{Binding !IsAlleenLezen}"
								Classes="AccentBtn"
								Margin="0,0,12,6"/>

						<Button Content="{Binding BestelbonButtonText}"
								Command="{Binding BestelbonCommand}"
								Background="{DynamicResource InfoBorder}"
								Foreground="{DynamicResource InfoText}"
								FontWeight="Bold"
								Margin="0,0,12,6"/>

						<!-- Bevestigen: alleen zichtbaar als er nog GEEN werkbon is -->
						<Button Content="Bevestigen → Werkbon"
								Command="{Binding BevestigenCommand}"
								IsVisible="{Binding IsBevestigenZichtbaar}"
								Classes="AccentBtn"
								Margin="0,0,12,6"/>

						<!-- Planning: zichtbaar zodra de werkbon bestaat -->
						<Button Content="Planning bekijken"
								Command="{Binding OpenPlanningCommand}"
								IsVisible="{Binding IsPlanningZichtbaar}"
								Background="{DynamicResource SuccessBg}"
								Foreground="{DynamicResource Success}"
								FontWeight="Bold"
								Margin="0,0,12,6"/>
					</WrapPanel>

					<Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
							Background="{Binding Offerte.Status, Converter={x:Static conv:OfferteStatusToBrushConverter.Instance}}"
							IsVisible="{Binding Offerte, Converter={x:Static ObjectConverters.IsNotNull}}">
						<TextBlock Text="{Binding Offerte.Status, Converter={x:Static conv:StatusLabelConverter.Instance}}"
								   Foreground="White" FontWeight="SemiBold" FontSize="12"/>
					</Border>

					<!-- US-56: manueel de offerte-status wijzigen (enkel Concept/Verzonden/Goedgekeurd;
					     voorbij Goedgekeurd blijft dit blokje verborgen). -->
					<WrapPanel IsVisible="{Binding IsManueleStatusWijzigingZichtbaar}">
						<Button Content="→ Verzonden" Classes="GhostBtn" FontSize="11" Padding="8,2"
								Command="{Binding NaarVerzondenCommand}"
								IsVisible="{Binding KanNaarVerzonden}"
								Margin="0,0,6,0"/>
						<Button Content="↩ Concept" Classes="GhostBtn" FontSize="11" Padding="8,2"
								Command="{Binding TerugNaarConceptCommand}"
								IsVisible="{Binding KanTerugNaarConcept}"
								Margin="0,0,6,0"/>
						<Button Content="↩ Verzonden" Classes="GhostBtn" FontSize="11" Padding="8,2"
								Command="{Binding TerugNaarVerzondenCommand}"
								IsVisible="{Binding KanTerugNaarVerzonden}"/>
					</WrapPanel>

					<TextBlock Text="{Binding BestelbonStatusText}"
							   Classes="label"
							   Foreground="{DynamicResource TextSecondary}"
							   TextTrimming="CharacterEllipsis"
							   ToolTip.Tip="{Binding BestelbonStatusText}"/>
				</StackPanel>

				<!-- RECHTS PRIJZEN (US-91: eigen control) -->
				<offerte:OfferteTotalen Grid.Column="1" HorizontalAlignment="Right"/>

			</Grid>
		</Border>

	</Grid>
</UserControl>
